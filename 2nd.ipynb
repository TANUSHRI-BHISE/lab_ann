   "source": [
    "#tanushri bhise A-26\n",
    "# McCulloch-Pitts ANDNOT function\n",
    "w1=1\n",
    "w2=-1\n",
    "theta=1\n",
    "inputs=[(0,0),(0,1),(1,0),(1,1)]\n",
    "\n",
    "print(\" X1 X2 | OUTPUT\")\n",
    "\n",
    "for x1 ,x2 in inputs:\n",
    "    yin=w1*x1+w2*x2\n",
    "    if yin>= theta:\n",
    "        y=1\n",
    "    else:\n",
    "        y=0\n",
    "    print(x1,\"  \",x2 ,\"   |\",y)"
   ]
